#!/bin/bash

SERVER_LIST="/home/neeraj/server.txt"
REPORT="/home/neeraj/service_check_$(date +%Y%m%d_%H%M%S).txt"

# Fixed email recipients
MAIL_TO="person1@company.com person2@company.com person3@company.com"

echo "==================================================" > "$REPORT"
echo "           RHEL SERVICE STATUS REPORT" >> "$REPORT"
echo "Date: $(date)" >> "$REPORT"
echo "==================================================" >> "$REPORT"

while read -r SERVER
do
    # Skip blank lines and comments
    [[ -z "$SERVER" || "$SERVER" =~ ^# ]] && continue

    echo "" >> "$REPORT"
    echo "SERVER: $SERVER" >> "$REPORT"
    echo "--------------------------------------------------" >> "$REPORT"

    ssh -o ConnectTimeout=10 \
        -o BatchMode=yes \
        "$SERVER" '

        echo "================ CENTRIFYDC ================"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl status centrifydc --no-pager
        else
            service centrifydc status
        fi

        echo ""
        echo "================ ADINFO ===================="
        if command -v adinfo >/dev/null 2>&1; then
            adinfo
        else
            echo "adinfo command not found"
        fi

        echo ""
        echo "================ FIREWALLD ================="
        if command -v systemctl >/dev/null 2>&1; then
            systemctl status firewalld --no-pager
        else
            service firewalld status
        fi

    ' >> "$REPORT" 2>&1

    if [ $? -ne 0 ]; then
        echo "ERROR: Unable to connect to server" >> "$REPORT"
    fi

done < "$SERVER_LIST"

echo "" >> "$REPORT"
echo "==================================================" >> "$REPORT"
echo "Report completed: $(date)" >> "$REPORT"
echo "==================================================" >> "$REPORT"

# Send email
mailx -s "RHEL Service Status Report - $(date '+%Y-%m-%d')" \
"$MAIL_TO" < "$REPORT"
